CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Enabling the following configurations can help increase the PCLK frequency in the case when
# the Frame Buffer is allocated from the PSRAM and fetched by EDMA
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED is not set
# CONFIG_BT_HID_ENABLED is not set  
# CONFIG_BT_HID_HOST_ENABLED is not set
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_GATTC_NOTIF_REG_MAX=10
# How long one BLE connection attempt waits for the keyboard (default 30 s).
# An attempt cannot be cancelled, so this is also how long "Connect" in
# Settings -> Bluetooth Keyboard blocks on a keyboard that is switched off,
# and how long the user's own scan / unpair can queue behind a background
# reconnect attempt. A keyboard that is awake answers within a second or two.
CONFIG_BT_BLE_ESTAB_LINK_CONN_TOUT=10

# -O2 instead of the default -Og: the Z80 interpreter is the hot loop and
# -Og left it little headroom at Model III speed (see TRASHBOY_PERF_DIAG).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Bigger LVGL fonts for splash UI (status @ 24 px, list/details @ 20 px,
# main menu entries @ 48 px)
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# NOTE: do NOT enable CONFIG_LCD_RGB_RESTART_IN_VSYNC here. It restarts the
# LCD DMA on EVERY vsync (unconditionally — see lcd_rgb_panel_try_restart_
# transmission), which itself causes constant visible flicker. The driver's
# default underrun detection restarts only when actually desynced, and
# main.cpp does one explicit esp_lcd_rgb_panel_restart() after flash-write
# bursts (game-cache mount/sync) to guarantee realignment.


# mDNS (started by TRS-IO's web server) in PSRAM, task stack included: once
# Wi-Fi is up internal RAM has ~7 KB in one piece, and TRS-IO aborts the
# whole firmware (ESP_ERROR_CHECK) when mdns_init() can't get its 4 KB stack.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# Internal SRAM is the scarce resource with Wi-Fi + BLE + TRS-IO's web server
# + the emulator: in Mini TRS mode it ran down to 1 KB free, the Wi-Fi driver
# failed allocations ("wifi:m f null") and the web UI took minutes to load.
# Let Wi-Fi/lwIP and Bluetooth buffers live in PSRAM, and let malloc() use
# PSRAM for anything over 1 KB (the default 16 KB kept e.g. every web-server
# connection buffer internal).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
