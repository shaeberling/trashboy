CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Enabling the following configurations can help increase the PCLK frequency in the case when
# the Frame Buffer is allocated from the PSRAM and fetched by EDMA
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED is not set
# CONFIG_BT_HID_ENABLED is not set  
# CONFIG_BT_HID_HOST_ENABLED is not set
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_GATTC_NOTIF_REG_MAX=10

# Bigger LVGL fonts for splash UI (status @ 24 px, list/details @ 20 px)
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# NOTE: do NOT enable CONFIG_LCD_RGB_RESTART_IN_VSYNC here. It restarts the
# LCD DMA on EVERY vsync (unconditionally — see lcd_rgb_panel_try_restart_
# transmission), which itself causes constant visible flicker. The driver's
# default underrun detection restarts only when actually desynced, and
# main.cpp does one explicit esp_lcd_rgb_panel_restart() after flash-write
# bursts (game-cache mount/sync) to guarantee realignment.

