CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_PERF_MONITOR=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# What makes a sdkconfig generated from these defaults build and run the
# emulator, on either board (the continuous integration builds that way, and
# so does scripts/watcher.sh). trs-lib and TRS-IO do not build warning-free;
# the Z80 runs on the main task.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_COMPILER_ORPHAN_SECTIONS_WARNING=y
CONFIG_LIBC_NEWLIB=y
CONFIG_FREERTOS_IN_IRAM=y
# CONFIG_ESP_TASK_WDT_EN is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000
